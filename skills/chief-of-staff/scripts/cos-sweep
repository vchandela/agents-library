#!/usr/bin/env python3
"""One line per coordinator thread: moving, waiting, stalled or lost.

Reads only: the registry (~/.claude/cos/threads.json), the session records
(~/.claude/sessions/*.json), the tmux panes and the transcript mtimes.
Exit 0 when every thread is moving or waiting on a recorded person or event;
exit 1 when any ACT line needs the coordinator.

With --state it prints one JSON line instead, for scripts/cos-watch: the ACT
lines, a fingerprint of every thread's status and wait (no ages, so a quiet
fleet keeps the same fingerprint), and "quiet": true when no thread is busy
and every work thread waits on a person or event rather than on itself or its
reviewer, so nothing can stall until someone answers.

Usage: cos-sweep [--registry PATH] [--idle-minutes N] [--state]
"""
import argparse
import glob
import json
import os
import subprocess
import sys
import time

MARKERS = (
    "Enter to continue",
    "Esc to cancel",
    "Do you want to",
    "waiting for approval",
)


def alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError):
        return False


def pane_tail(target, lines=12):
    try:
        out = subprocess.run(
            ["tmux", "capture-pane", "-p", "-t", target],
            capture_output=True, text=True, timeout=2,
        )
        return out.stdout.splitlines()[-lines:]
    except Exception:
        return []


def transcript_path(rec):
    cwd = rec.get("cwd") or ""
    sid = rec.get("sessionId") or ""
    return os.path.expanduser(
        "~/.claude/projects/%s/%s.jsonl" % (cwd.replace("/", "-"), sid)
    )


def transcript_age(rec):
    try:
        return time.time() - os.path.getmtime(transcript_path(rec))
    except OSError:
        return None


def unanswered_since(rec):
    """The time of the last message from another session that this session
    has not answered with a turn of its own, or None."""
    asked = answered = ""
    try:
        with open(transcript_path(rec)) as f:
            for line in f:
                try:
                    r = json.loads(line)
                except Exception:
                    continue
                ts = r.get("timestamp") or ""
                if r.get("type") == "user" and "cross-session-message" in line:
                    asked = ts
                elif r.get("type") == "assistant":
                    answered = ts
    except OSError:
        return None
    return asked if asked and answered < asked else None


def fmt_age(seconds):
    if seconds is None:
        return "?"
    minutes = int(seconds // 60)
    if minutes < 120:
        return "%dm" % minutes
    return "%dh" % (minutes // 60)


def norm(text):
    return (text or "").lower().replace("-", "").replace("_", "")


def load_suite_ends():
    path = os.path.expanduser("~/.claude/flows/suite-runs.log")
    ends = []
    try:
        with open(path) as f:
            for line in f:
                try:
                    r = json.loads(line)
                except Exception:
                    continue
                if r.get("event") == "end":
                    ends.append(r)
    except OSError:
        pass
    return ends


def load_live():
    live = {}
    for f in glob.glob(os.path.expanduser("~/.claude/sessions/*.json")):
        try:
            rec = json.load(open(f))
        except Exception:
            continue
        if rec.get("kind") != "interactive" or not rec.get("name"):
            continue
        if not alive(rec.get("pid", -1)):
            continue
        live.setdefault(rec["name"], []).append(rec)
    for recs in live.values():
        recs.sort(key=lambda r: r.get("updatedAt") or 0)
    return live


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument(
        "--registry", default=os.path.expanduser("~/.claude/cos/threads.json")
    )
    ap.add_argument("--idle-minutes", type=int, default=20)
    ap.add_argument("--state", action="store_true")
    args = ap.parse_args()

    try:
        registry = json.load(open(args.registry))
        threads = registry.get("threads", [])
    except Exception as e:
        print("ACT registry: cannot read %s: %s" % (args.registry, e))
        return 1

    live = load_live()
    ends = load_suite_ends()
    acts, needs, oks = [], [], []
    fingerprint, quiet = {}, True
    for t in threads:
        name = t.get("name")
        stage = t.get("stage") or "?"
        if stage == "closed":
            continue
        if t.get("needs_user"):
            needs.append("NEEDS %s: %d decision(s), first: %s" % (
                name, len(t["needs_user"]), t["needs_user"][0]))
        recs = live.get(name)
        if not recs:
            acts.append("ACT %s lost: no live session (stage %s, next: %s)" % (
                name, stage, t.get("next") or "?"))
            continue
        rec = recs[-1]
        status = rec.get("status") or "?"
        wait = t.get("waiting_on") or ""
        reviewer = t.get("role") == "reviewer"
        fingerprint[name] = [status, wait, len(t.get("needs_user") or [])]
        if status not in ("idle", "shell"):
            quiet = False
        elif not reviewer and (not wait or wait.lower().startswith(("self", "reviewer"))):
            quiet = False
        age = transcript_age(rec)
        bits = [status, "active %s" % fmt_age(age), "stage %s" % stage]
        if wait:
            bits.append("waiting on %s" % wait)

        # A background run can finish red after the session's last turn, and a
        # completion notice does not always wake an idle session. A failed end
        # line newer than the transcript is an unread failure. Name runs after
        # the thread so this check can find them.
        if age is not None:
            for line in reversed(ends):
                if not norm(line.get("who")).startswith(norm(name)):
                    continue
                if (line.get("t") or 0) <= time.time() - age:
                    break
                if line.get("result") != "passed":
                    acts.append(
                        "ACT %s unread failed run: %s, tree %s, key %s, %s s; read it and act"
                        % (name, line.get("who"), (line.get("tree") or "")[:12],
                           line.get("key"), line.get("seconds")))
                break

        reg_addr = t.get("address") or ""
        live_addr = rec.get("messagingSocketPath") or ""
        reg_bare = reg_addr[4:] if reg_addr.startswith("uds:") else reg_addr
        if reg_addr.startswith("uds:") and live_addr and reg_bare != live_addr:
            acts.append("ACT %s address: registry %s, live uds:%s" % (
                name, reg_addr, live_addr))

        target = (rec.get("tmux") or "").split(":")[0]
        tail = pane_tail(target) if target else []
        marker = next((m for m in MARKERS if m in "\n".join(tail)), None)
        if marker:
            acts.append(
                "ACT %s stall: pane shows %r; dismiss with tmux send-keys -t %s Enter"
                % (name, marker, target))
            continue
        if status == "waiting":
            acts.append("ACT %s waiting for input in the pane (%s); answer it or record why" % (
                name, " ".join(bits)))
            continue
        # An idle reviewer with an unanswered request stalls its author, and
        # neither of them sends a message about it.
        if reviewer and status in ("idle", "shell"):
            since = unanswered_since(rec)
            if since:
                acts.append(
                    "ACT %s reviewer has not answered the request of %s (author %s); nudge it"
                    % (name, since, t.get("pair") or "?"))
                continue
        if status in ("idle", "shell") and not wait and stage not in ("parked", "merged"):
            acts.append(
                "ACT %s idle with no recorded wait (%s); ask for its next step or record what it waits on"
                % (name, " ".join(bits)))
            continue
        oks.append("OK  %s: %s" % (name, " ".join(bits)))

    if args.state:
        print(json.dumps({"acts": acts, "fingerprint": fingerprint,
                          "quiet": quiet and not acts}, sort_keys=True))
        return 1 if acts else 0
    for line in oks:
        print(line)
    for line in acts:
        print(line)
    for line in needs:
        print(line)
    known = {t.get("name") for t in threads}
    try:
        me = open(os.path.expanduser("~/.claude/cos/coordinator")).read().strip()
        me = me[4:] if me.startswith("uds:") else me
        for name, recs in live.items():
            if any(r.get("messagingSocketPath") == me for r in recs):
                known.add(name)
    except OSError:
        pass
    extra = sorted(set(live) - known)
    if extra:
        print("INFO not in registry: %s" % ", ".join(extra))
    return 1 if acts else 0


if __name__ == "__main__":
    sys.exit(main())
