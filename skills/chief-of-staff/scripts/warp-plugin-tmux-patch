#!/usr/bin/env python3
"""Patch the installed Warp Claude Code plugin so its status codes reach Warp from inside tmux.

Warp shows a tab's Claude icon and busy/done state from OSC 777 codes the plugin
emits. Inside tmux, Claude Code does not pass the plugin's terminalSequence to the
pane, and tmux drops an unwrapped code. The patch makes the plugin write the code,
wrapped in tmux's passthrough envelope, straight to its own pane's tty. Needs
`set -g allow-passthrough on` in ~/.tmux.conf. Safe to run repeatedly; a plugin
update installs a new version directory, which the next run patches.
"""
import glob, os

MARK = "# tmux passthrough (warp-plugin-tmux-patch)"
OLD = '    local seq="$1"\n    [ -z "$seq" ] && return 0\n'
NEW = OLD + r'''
    MARK
    if [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ]; then
        local tty
        tty=$(tmux display-message -p -t "$TMUX_PANE" '#{pane_tty}' 2>/dev/null)
        if [ -n "$tty" ] && [ -w "$tty" ]; then
            printf '\033Ptmux;%s\033\\' "$(printf '%s' "$seq" | perl -pe 's/\e/\e\e/g')" > "$tty"
            return 0
        fi
    fi
'''.replace("MARK", MARK)

paths = glob.glob(os.path.expanduser("~/.claude/plugins/cache/claude-code-warp/warp/*/scripts/emit-terminal-sequence.sh"))
for p in paths:
    s = open(p).read()
    if MARK in s:
        print(f"already patched {p}"); continue
    if OLD not in s:
        print(f"NOT PATCHED, plugin changed shape: {p}"); continue
    open(p, "w").write(s.replace(OLD, NEW, 1)); print(f"patched {p}")
if not paths:
    print("Warp plugin not installed; nothing to patch")
